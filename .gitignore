/coverage
*.test_run_id*

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Environment files (comprehensive coverage)
*settings.local.json*
*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb
docs/architecture/db_dump/
logs/
*.log

# Generated performance-run raw logs can be very large; keep summary/report
