# ==================== TEMPLATE ONLY — NO REAL SECRETS ====================
# This file is COMMITTED to git. Every value below is a placeholder.
# NEVER paste a live secret here, and never create it by copying backend/.env.
# Real values belong only in backend/.env (gitignored) or the deploy secret store.
# If you find a real value in this file, treat it as leaked: rotate it, then
# replace it with a placeholder.


# ==================== DATABASES ====================
# MongoDB remains the live operational store during the phased Postgres cutover.
MONGO_URL=mongodb://<mongo-user>:<mongo-password>@localhost:27018/?authSource=admin
DB_NAME=strataos_production

# PostgreSQL financial core and control-plane schema.
DATABASE_URL=postgresql+asyncpg://<pg-user>:<pg-password>@127.0.0.1:5432/strataos_production


# ==================== WORKERS / QUEUES / ORCHESTRATION ====================
# Consumed by processes started separately from the API (workers/), never by
# `uvicorn server:app`. Each falls back to the in-code default shown.

# ARQ task queue + the Redis Streams event bus (core/events.py -> workers/).
# Unset means the ARQ worker refuses to start; the legacy scheduler path and the
# API itself are unaffected.
# REDIS_URL=redis://localhost:6379/0
# Cap on entries retained per Redis stream. Default: 100000.
# REDIS_STREAM_MAXLEN=100000

# Temporal workflow orchestration (workers/temporal_worker.py). The task queue
# must match between the worker and whatever starts the workflow.
# TEMPORAL_HOST=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=strata-financial
# mTLS client cert/key. Required for Temporal Cloud, omit for local Temporalite.
# TEMPORAL_TLS_CERT=<path-to-client-cert.pem>
# TEMPORAL_TLS_KEY=<path-to-client-key.pem>

# ==================== APPLICATION ====================
APP_ENV=production
APP_NAME='StrataOS Strata Management'
APP_URL=https://eastgateresidences.com.au
API_URL=https://eastgateresidences.com.au
FRONTEND_URL=https://eastgateresidences.com.au
TIMEZONE=Australia/Canberra

# Demo bootstrap is intentionally enabled in production so the platform demo
# chain exists. Set true only when an operator explicitly wants startup seeding off.
# DISABLE_DEMO_BOOTSTRAP=true


# Public-facing URLs used in outgoing mail when they differ from APP_URL.
# PUBLIC_APP_URL=https://<your-domain>
# WEBMAIL_URL=https://webmail.<your-domain>
# MAIL_URL=https://mail.<your-domain>

# Shown in cron-generated notices (escalation, auto-approval). Default:
# "Your Strata Community". This is display text only — it is NOT a tenant
# selector, and must never be used to scope a query.
# BUILDING_NAME=<your-building-display-name>

# Contact details rendered in outbound templates and the public site.
# CONTACT_EMAIL=<contact@your-domain>
# CONTACT_PHONE=<+61 2 0000 0000>

# Minutes before cron_admin_auto_approve escalates a pending admin action.
# Default: 15.
# ADMIN_AUTO_APPROVE_MINUTES=15

# ==================== SECURITY ====================
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=<generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))">
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=<generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# Shared header secret used by external cron callers.
CRON_SECRET=<generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))">


# ==================== NETWORK / CORS ====================
CORS_ORIGINS=https://eastgateresidences.com.au,https://www.eastgateresidences.com.au,https://eastgate.gagneet.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3020,http://127.0.0.1:3020
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128


# ==================== EMAIL PROVIDERS ====================
# EMAIL_PROVIDER may be "resend", "sendgrid", or "smtp".
EMAIL_PROVIDER=smtp

# Resend.
RESEND_API_KEY=<your-resend-api-key>

# SendGrid.
SENDGRID_API_KEY=<your-sendgrid-api-key>

# SMTP.
SMTP_HOST=smtp.migadu.com
SMTP_PORT=465
SMTP_USER=noreply@eastgateresidences.com.au
SMTP_PASSWORD=<your-smtp-password>

# Sender identity.
SENDER_EMAIL=noreply@strataos.live
SENDER_NAME='StrataOS Notifications'

# Migadu API used by /admin/reset-user-passwords to sync mailbox passwords.
MIGADU_API_KEY=<your-migadu-api-key>
MIGADU_ADMIN_EMAIL=<your-migadu-admin-email>
MIGADU_DOMAIN=eastgateresidences.com.au


# ==================== EMAIL DELIVERY CONTROLS ====================
# Primary email control is the per-building feature toggle
# email_notifications_enabled. The variables below are process-wide backstops.

# Persist outgoing mail to outbound_messages for operator review instead of
# transmitting inline. Delivery still obeys the suppression variables below.
OUTBOUND_QUEUE_ENABLED=true

# Only these recipient domains may receive mail. Empty or unset means no domain
# restriction. This is checked before building resolution.
EMAIL_ALLOWED_DOMAINS=eastgateresidences.com.au

# Platform-wide hard stop. Checked first and suppresses all outgoing email,
# including invitations, password resets, approval notices, and cron mail.
EMAIL_SEND_DISABLED_ALL=true

# Comma-separated building IDs whose mail is suppressed outright.
EMAIL_SEND_DISABLED_BUILDING_IDS=13195,16244

# Allow email whose building cannot be resolved, such as invitations to new users.
EMAIL_ALLOW_UNRESOLVED_BUILDING=true

# Blind-copied on registration notifications. Empty means no BCC.
# REGISTRATION_NOTIFY_BCC_EMAIL=<ops@your-domain>

# Dev/test only. Redirects all outgoing mail to this address when set.
# TEST_EMAIL_INTERCEPT_ADDRESS=


# ==================== INBOUND WEBHOOK / M2M SECRETS ====================
# Required for endpoints without an authenticated user. Unset secrets fail closed.
DEFT_WEBHOOK_SECRET=<generate: openssl rand -hex 32>
EMAIL_INGEST_API_KEY=<generate: openssl rand -hex 32>
COMMUNICATIONS_INBOUND_EMAIL_WEBHOOK_SECRET=<generate: openssl rand -hex 32>


# Mailgun inbound signature verification. Empty means inbound Mailgun mail is
# rejected rather than trusted.
# MAILGUN_WEBHOOK_SIGNING_KEY=<your-mailgun-signing-key>

# ==================== EXTERNAL SERVICE MOCKING ====================
# Process-wide kill switch for outbound real-money integrations. This can only
# force mock mode on; it cannot promote a building to live integrations.
MOCK_EXTERNAL_SERVICES=true


# ==================== FILE STORAGE ====================
FILE_STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif


# Generated ABA (direct-entry) payment files. Default: /tmp/aba.
# ABA_UPLOAD_PATH=/var/lib/strataos/aba
# Exported trust-account seal artefacts. Default: /tmp/trust_seals.
# SEAL_EXPORT_PATH=/var/lib/strataos/trust_seals

# ==================== PAYMENTS / INTEGRATIONS ====================
# Stripe test mode.
STRIPE_SECRET_KEY=<your-stripe-test-secret-key>
STRIPE_PUBLISHABLE_KEY=<your-stripe-test-publishable-key>
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>

# Twilio SMS/WhatsApp notifications.
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_PHONE_NUMBER=+61400000000
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Australian Business Register lookup.
ABN_LOOKUP_GUID=<your-abn-lookup-guid>


# Australian Business Register live lookup. ABR_API_GUID is the key the
# validator actually reads (integrations/abn_validator.py); without it ABN
# checks fall back to local checksum validation and report "Offline".
# ABR_API_GUID=<your-abr-guid>

# Parcel carrier tracking. Unset disables live tracking for that carrier.
# AUSPOST_API_KEY=<your-auspost-api-key>
# DHL_API_KEY=<your-dhl-api-key>

# ==================== SCRAPERS ====================
NEWS_SCRAPING_METHOD=rss
MAX_ARTICLES_PER_KEYWORD=10
MIN_CONTENT_LENGTH=150
RELEVANCE_THRESHOLD=0.12
SERPER_API_KEY=<your-serper-api-key>

PROPERTY_SCRAPER_ENABLED=true
PROPERTY_LISTING_EXPIRY_DAYS=30
MAX_LISTINGS_PER_SUBURB=10


# ==================== STRATA PORTAL ====================
PORTAL_EMAIL=<strata-portal-login-email>
PORTAL_PASSWORD=<strata-portal-login-password>


# ==================== TRIAL REQUEST FORM ====================
RECAPTCHA_SECRET_KEY=<your-recaptcha-v3-secret-key>
TRIAL_REQUEST_EMAIL=<trial-request-notification-email>
TRIAL_REQUEST_NAME='Silverfox Technologies'


# ==================== OCR / AI SERVICES ====================
# Optional invoice and quote parsing providers.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
MINDEE_API_KEY=<your-mindee-api-key>


# Unlimited-OCR backend for invoice/quote parsing. Disabled unless both
# UNLIMITED_OCR_ENABLED=true and a backend other than "disabled" are set.
# UNLIMITED_OCR_ENABLED=false
# UNLIMITED_OCR_BACKEND=disabled
# UNLIMITED_OCR_ENDPOINT=<https://your-ocr-endpoint>
# UNLIMITED_OCR_API_KEY=<your-ocr-api-key>
# UNLIMITED_OCR_MODEL_VERSION=baidu/Unlimited-OCR@unconfigured
# UNLIMITED_OCR_DEFAULT_MODE=auto
# UNLIMITED_OCR_MAX_PAGES=25
# UNLIMITED_OCR_MAX_BYTES=<bytes>
# UNLIMITED_OCR_PDF_DPI=300
# UNLIMITED_OCR_TIMEOUT_SECONDS=1200

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log


# ==================== DEVELOPMENT ====================
DEBUG=false
RELOAD=false
# RATE_LIMIT_DISABLED=true

# Bypass the rate limiter entirely. Never set in production.
# DISABLE_RATE_LIMIT=true
# Skip HMAC verification on the inbound email webhook. Never set in production —
# the endpoint fails closed without it for a reason.
# EMAIL_WEBHOOK_SKIP_VERIFY=true
# Log every feature-toggle resolution (3-tier: user -> building -> global).
# FEATURE_TOGGLE_DEBUG=true

# Seed-script passwords. Read only by scripts under seeds/, which refuse to run
# without them rather than falling back to a committed constant. Pass them on
# the command line for a single run instead of persisting them here.
# SEED_DEFAULT_PASSWORD=<set-per-run-on-the-command-line>
# SEED_SUPER_ADMIN_PASSWORD=<set-per-run-on-the-command-line>
# SEED_TEST_USER_PASSWORD=<set-per-run-on-the-command-line>

# One-shot building override for cron_finance_recompute. A per-invocation CLI
# override only — setting it here would pin every recompute to one tenant.
# BUILDING_ID=<building-id-for-a-single-manual-run>
